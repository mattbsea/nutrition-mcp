{
    "name": "food-mcp",
    "version": "1.32.0",
    "description": "A single-container, self-hosted MCP server for personal nutrition tracking (fork of nutrition-mcp for Home Assistant). SQLite storage, secret-path access.",
    "author": "Anton Kutishevskyi",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/akutishevsky/nutrition-mcp.git"
    },
    "keywords": [
        "mcp",
        "nutrition",
        "meal-tracking",
        "claude",
        "model-context-protocol"
    ],
    "module": "index.ts",
    "type": "module",
    "private": true,
    "devDependencies": {
        "@modelcontextprotocol/client": "^2.4.0",
        "@types/bun": "latest"
    },
    "peerDependencies": {
        "typescript": "^5.9.3"
    },
    "scripts": {
        "start": "bun src/index.ts",
        "dev": "bun --watch src/index.ts",
        "inspect": "bunx @modelcontextprotocol/inspector",
        "harness": "bun run scripts/widget-harness.ts",
        "test": "bun test",
        "format": "bunx prettier --write .",
        "format:check": "bunx prettier --check .",
        "typecheck": "bun run scripts/typecheck.ts"
    },
    "dependencies": {
        "@modelcontextprotocol/server": "^2.4.0",
        "hono": "^4.13.14",
        "prettier": "^3.9.10",
        "zod": "^4.6.7"
    }
}
