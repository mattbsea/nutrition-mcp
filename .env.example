# All state lives under DATA_DIR: nutrition.db (SQLite), keys.json (mode 600),
# exports/. The Home Assistant add-on sets /data.
DATA_DIR=./data

# The secret in the MCP URL path: https://<host>/mcp/<MCP_KEY>. Leave unset to
# have 48 random bytes generated once and saved to DATA_DIR/keys.json (the
# startup log says where, never what). At least 16 characters when set.
MCP_KEY=

# The bearer key of the Apple Health shortcuts (Authorization: Bearer <key>).
# Leave unset to generate 48 random bytes once into DATA_DIR/keys.json. Must be
# different from MCP_KEY. At least 16 characters when set.
SHORTCUT_KEY=

# Listening address.
PORT=8080
HOST=0.0.0.0

# 1 when a reverse proxy you control (Nginx Proxy Manager) is in front: the
# RIGHTMOST X-Forwarded-For entry is then the client address used for failure
# rate limiting. Leave unset otherwise: the header is ignored.
TRUST_PROXY=

# Public origin (scheme + host, no path) used to build the export download link
# the export_all_data tool returns. Without it the tool returns the bare
# /exports/download?... path.
PUBLIC_URL=

# Open Food Facts requires a User-Agent identifying your app + contact, in the
# form "AppName (email)". Used for barcode lookups (lookup_barcode tool).
OFF_USER_AGENT=food-mcp (you@example.com)
USDA_API_KEY=

# (optional) ISO-8601 date, or date-time with an offset, from which log_meal /
# update_meal refuse sugar_g given without added_sugar_g. Unset/empty/invalid = off.
ADDED_SUGAR_REQUIRED_FROM=
